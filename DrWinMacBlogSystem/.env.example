# Dr.WinMac Blog API - Environment Configuration
# Copy this file to .env and fill in your actual values

# ─── REQUIRED: OpenAI Configuration ──────────────────────────────────────

# Your OpenAI API key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ─── REQUIRED: Admin Authentication ─────────────────────────────────────

# Strong passcode for admin dashboard access
# Should be 16+ characters, mix of upper/lowercase, numbers, symbols
ADMIN_PASSCODE=your-secure-passcode-here

# ─── REQUIRED: Email Configuration (Namecheap) ─────────────────────────

# SMTP server (Namecheap uses mail.privateemail.com)
SMTP_HOST=mail.privateemail.com

# SMTP port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# Your email address (the one sending previews)
SMTP_USER=jeremy@drwinmac.tech

# Your email password
SMTP_PASSWORD=your-email-password-here

# ─── OPTIONAL: Blog Configuration ────────────────────────────────────────

# Path to blog directory (relative to app.py)
# Default: ../blog
BLOG_PATH=../blog

# ─── OPTIONAL: Server Configuration ─────────────────────────────────────

# Port to run API on (default: 5000)
PORT=5000

# Environment: development or production
# Use 'development' for local testing with hot reload
FLASK_ENV=production

# CORS origins (comma-separated for multiple)
# Default: * (allow all)
CORS_ORIGINS=*

# ─── OPTIONAL: Rate Limiting ────────────────────────────────────────────

# Max API requests per time window
RATE_LIMIT_REQUESTS=10

# Time window for rate limiting (seconds)
RATE_LIMIT_WINDOW=3600
